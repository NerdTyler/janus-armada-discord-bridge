# Janus bridge configuration — copy to ~/.config/janus/janus.env (chmod 600)
# and fill in your own values. Both legs read the same file (the systemd
# units load it via EnvironmentFile).
#
# Secrets (DISCORD_TOKEN, ARMADA_BRIDGE_NSEC) belong ONLY in that file on
# your own machine — never commit them, never paste them into chat or issues.

# --- Shared ---------------------------------------------------------------
# Unix socket the Discord leg connects to (the Rust process owns it).
# Under systemd the units create the runtime dir; this explicit path wins.
# Replace 1000 with your uid (`id -u`) if it differs.
BRIDGE_SOCKET_PATH=/run/user/1000/janus/pcm.sock
# Armada identity data dir (SDK state; holds the identity if minted there).
BRIDGE_DATA_DIR=/home/youruser/.local/share/janus
# Display name on both platforms.
BRIDGE_NAME_DISCORD=Janus
BRIDGE_NAME_ARMADA=Janus
# Armada voice broker (SFU front door). Leave unset unless your Armada
# deployment uses a different broker.
#BRIDGE_BROKER=https://av.armada.buzz
# Who may summon/leave the bridge, on BOTH platforms:
#   whitelist = the owner (below) + the per-platform friend lists only
#   open      = ANYONE in the Discord guild / Armada community
# Start with whitelist. In code, an unset/empty/invalid value falls back
# to whitelist (the safe default). Note: status commands and Armada
# invite auto-accept stay owner-only in BOTH modes.
SUMMON_ACCESS=whitelist
# Speaking-indicator relay across platforms: off in v1.
SPEAKING_RELAY=off
# Chat-visible session start/stop announcements on BOTH legs (Armada text
# channel + Discord text channel): only "on" enables them. Unset or any
# other value is silent. Journal logging keeps the full session record
# either way. The reference deployment runs with this off.
JANUS_ANNOUNCE=off

# --- Discord leg ----------------------------------------------------------
# Bot application token (Discord developer portal -> Bot -> Reset Token).
DISCORD_TOKEN=
# Your guild (server) id (Developer Mode -> right-click server -> Copy ID).
DISCORD_GUILD_ID=
# Landing-resolution fallback ONLY — not a pin. The bridge can join ANY
# voice channel in the guild; this is where it lands when a far-side
# summon names nothing and no channel is occupied.
DISCORD_HOME_VOICE_CHANNEL_ID=
# Text channel for session announcements (only used if JANUS_ANNOUNCE=on).
DISCORD_TEXT_CHANNEL_ID=
# Your Discord user id — always on the summon whitelist (you can never
# lock yourself out) and the only account /bridge status answers to.
DISCORD_OWNER_USER_ID=
# Conversational summon/leave on Discord: plain messages like "janus join"
# / "janus leave" in a guild text channel instead of the /bridge slash
# commands (which stay as backstops either way). Default: off.
# Requires BOTH of these:
#   1. DISCORD_CONVERSATIONAL=on here, AND
#   2. the MESSAGE_CONTENT privileged intent ENABLED for the bot in the
#      Discord developer portal (Bot -> Privileged Gateway Intents ->
#      Message Content Intent). Without it, Discord delivers message
#      events with empty text and nothing can ever match.
# The Armada side needs no portal anything — conversational triggers
# there are always on.
# The Discord-side per-stream VOLUME controls (!vols,
# !vol, conversational volume forms — see "Levels" below)
# ride this same gate, since they read the same messages:
# with DISCORD_CONVERSATIONAL=on, any Discord guild member
# may use them (the owner's decision, 2026-11-24; the
# Armada volume surface stays owner-only).
DISCORD_CONVERSATIONAL=off
# Presence auto-join: when a HUMAN joins a Discord voice channel while
# Janus has no active session, Janus starts one himself — he joins that
# Discord channel and lands on Armada by the usual far-side resolution.
# He still leaves only per the stay rule (no humans left in either
# channel) or a commanded leave. Bots never trigger it, and joins during
# a live session change nothing. Default: off; "on" enables. No portal
# intent needed (voice states ride the base intent set).
DISCORD_AUTOJOIN=off
# WHITELIST MODE ONLY (SUMMON_ACCESS=whitelist): friends who may also
# /bridge summon and /bridge leave — comma-separated Discord user ids.
# Format: DISCORD_SUMMON_USER_IDS=123456789012345678,234567890123456789
# Empty = owner only. Whitespace/duplicates are tolerated.
# Ignored while SUMMON_ACCESS=open (anyone may summon).
DISCORD_SUMMON_USER_IDS=

# --- Levels ---------------------------------------------------------------
# (Removed 2026-11-23: BRIDGE_GAIN_TO_DISCORD_DB /
# BRIDGE_GAIN_TO_ARMADA_DB and the mixer's tanh soft
# limiter — the audio path is unity passthrough with only
# the last-resort hard clamp at full scale. The variables
# are no longer read; delete them from live env files.)
# Added 2026-11-24 (a different mechanism than the removed
# master gains): MUSIC DUCKING + manual per-stream gains.
# Music sources are pulled down while any human on the same
# side is speaking, so people sit on top of the music;
# humans are never envelope-reduced. Every value below
# falls back to the shown default when unset or unparseable.
# Kill switch: only the exact value "off" disables ducking
# (manual !vol gains still apply).
JANUS_DUCK=on
# Gain music ducks TO, 0.05–1.0 (0.30 = 30%).
JANUS_DUCK_GAIN=0.30
# Envelope timing: ramp down over ATTACK ms, stay ducked
# HOLD ms after the last speech frame, ramp back over
# RELEASE ms.
JANUS_DUCK_ATTACK_MS=100
JANUS_DUCK_HOLD_MS=1500
JANUS_DUCK_RELEASE_MS=1000
# Speech detection on human sources: a frame's RMS at or
# above RMS_ON engages the duck; speech reads as over only
# when every human frame is at or below RMS_OFF
# (hysteresis — RMS_OFF must be below RMS_ON).
JANUS_DUCK_RMS_ON=0.02
JANUS_DUCK_RMS_OFF=0.01
# WHICH Armada sources are music: comma-separated npubs.
# Unset = the music bot alone (the baked-in MUSIC_BOT_NPUB
# in armada-leg/src/main.rs). A voice bot that talks is
# deliberately NOT listed — a source not on this list is
# treated as a human, never ducked. (Armada
# SFU identities are random per join; the daemon resolves
# npub->identity from voice presence at runtime.)
# Format: JANUS_DUCK_MUSIC_NPUBS=npub1...,npub1...
JANUS_DUCK_MUSIC_NPUBS=
# Discord-side music sources, if a Discord music bot is
# ever bridged: comma-separated Discord user ids (stable,
# so these are matched directly). Empty = none.
JANUS_DUCK_MUSIC_DISCORD_IDS=
# Per-stream manual gains have NO env config: they are set
# from Armada chat by the owner alone (!vol / !vols and
# conversational forms — see armada-leg/src/vol.rs), are
# runtime state for the current session only, and reset to
# 100% when the session ends. Nothing to set here.

# --- Armada leg -----------------------------------------------------------
# The bridge's own Nostr secret key (nsec1...). Generate a fresh keypair
# for the bridge — do NOT reuse your personal key. The bridge joins your
# Armada community via a kind-3313 invite you generate for this identity
# in your Armada client; the daemon auto-accepts invites from
# ARMADA_OWNER_NPUB only (regardless of SUMMON_ACCESS) and joins.
ARMADA_BRIDGE_NSEC=
# Landing fallback on the Armada side (hex channel id of a voice channel
# in your community). Used only when a summon names nothing and no
# channel is occupied.
ARMADA_VOICE_CHANNEL_ID=
# Text channel (hex id) for session announcements (only used if
# JANUS_ANNOUNCE=on). Empty = fall back to the community's
# "general-chat" channel.
ARMADA_TEXT_CHANNEL_ID=
# Your Armada npub — always on the summon whitelist and the only account
# !bridge status answers to. Note: invite auto-accept above stays
# owner-only regardless of the summon whitelist below.
ARMADA_OWNER_NPUB=
# WHITELIST MODE ONLY (SUMMON_ACCESS=whitelist): friends who may also
# !summon and !leave from Armada — comma-separated npubs.
# Format: ARMADA_SUMMON_NPUBS=npub1...,npub1...
# Empty = owner only. Whitespace/duplicates are tolerated.
# Ignored while SUMMON_ACCESS=open (anyone may summon).
ARMADA_SUMMON_NPUBS=
# Bots that never count as "someone" for the session emptiness decision:
# Janus leaves on his own only when no HUMANS remain in either bridged
# channel. Janus himself is always excluded; list OTHER bots that share
# the room here — e.g. a music bot that auto-summons Janus when its music
# starts. Comma-separated npubs.
# Format: ARMADA_BOT_NPUBS=npub1...,npub1...
ARMADA_BOT_NPUBS=
